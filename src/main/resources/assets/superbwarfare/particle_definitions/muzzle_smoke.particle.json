{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superbwarfare:muzzle_smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "superbwarfare:particle/muzzle/smoke"
      }
    },
    "components": {
      "sbm:fp_emitter_local_space": {
        "position": false,
        "rotation": false,
        "to_world": true
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.smoke_count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          "math.random(-0.18, 0.18)",
          "math.random(-0.12, 0.22)",
          -1
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.smoke_lifetime * math.random(0.8, 1.2)"
      },
      "minecraft:particle_initial_speed": "variable.smoke_speed * (0.8 + 0.4 * variable.particle_random_1)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-40, 40)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": "variable.smoke_drag",
        "linear_acceleration": [
          0,
          0.85,
          0
        ]
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.smoke_size * (0.8 + 0.4 * variable.particle_random_1)) + (variable.smoke_growth * (0.8 + 0.4 * variable.particle_random_2) * (variable.particle_age / variable.particle_lifetime))",
          "(variable.smoke_size * (0.8 + 0.4 * variable.particle_random_1)) + (variable.smoke_growth * (0.8 + 0.4 * variable.particle_random_2) * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 384,
          "texture_height": 96,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              96,
              96
            ],
            "step_UV": [
              96,
              0
            ],
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": [
              1,
              1,
              1,
              "0.376 * variable.smoke_opacity * (0.7 + 0.4 * variable.particle_random_3)"
            ],
            "1.0": [
              1,
              1,
              1,
              0
            ]
          }
        }
      }
    }
  }
}
