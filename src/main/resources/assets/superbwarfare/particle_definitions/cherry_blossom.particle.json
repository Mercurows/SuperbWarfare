{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superbwarfare:cherry_blossom",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "minecraft:particle/cherry_0"
      }
    },
    "components": {
      "sbm:fp_emitter_local_space": {
        "position": false,
        "rotation": false,
        "to_world": true
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.smoke_count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0, 0],
        "radius": 0.12,
        "direction": [
          "math.random(-0.45, 0.45)",
          "math.random(-0.35, 0.35)",
          "-1"
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.size = variable.smoke_size * (0.7 + 0.6 * variable.particle_random_1) + variable.smoke_growth * (0.7 + 0.6 * variable.particle_random_2) * (variable.particle_age / variable.particle_lifetime);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.smoke_lifetime * math.random(0.7, 1.3)"
      },
      "minecraft:particle_initial_speed": "variable.smoke_speed * math.random(0.85, 1.15)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-420, 420)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -1.8, 0],
        "linear_drag_coefficient": "variable.smoke_drag",
        "rotation_acceleration": "math.random(-120, 120)",
        "rotation_drag_coefficient": 0.5
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_billboard": {
        "size": ["variable.size", "variable.size"],
        "facing_camera_mode": "rotate_xyz"
      }
    }
  }
}
